APP_NAME="Nankana Ordering"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Official domain — use these URLs everywhere (local + production)
APP_DOMAIN=nankanadistributors.com
APP_SCHEME=https
APP_URL=https://nankanadistributors.com
API_URL=https://nankanadistributors.com/api/v1
ADMIN_URL=https://nankanadistributors.com/admin
FRONTEND_URL=https://nankanadistributors.com
API_SUBDOMAIN=api
ADMIN_SUBDOMAIN=admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nankana_ordering
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nankanadistributors.com
# false for local HTTP; true required for HTTPS production admin sessions
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=nankanadistributors.com,www.nankanadistributors.com,localhost,127.0.0.1
# Comma-separated browser origins allowed to call the API. Leave empty to deny all (do not use *).
CORS_ALLOWED_ORIGINS=https://nankanadistributors.com,https://www.nankanadistributors.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Process queued emails/notifications locally:
# php artisan queue:work --tries=3

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Production SMTP example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nankanadistributors.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (customer push notifications)
FCM_ENABLED=false
FCM_SERVER_KEY=

# JazzCash sandbox credentials
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL="${APP_URL}/api/v1/payments/callback/jazzcash"

# Easypaisa sandbox credentials
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POSTBACK_URL="${APP_URL}/api/v1/payments/callback/easypaisa"

# Production (Forge / live server) — set these on the server:
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=error
# (APP_DEBUG is also forced off in config when APP_ENV=production.)
